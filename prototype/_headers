# Cloudflare Pages 头部配置（只有 Cloudflare 会读这个文件，GitHub Pages 会忽略）

# 全站安全头。这里只管「浏览器怎么对待这个站」，不涉及缓存，所以任何路径都套用
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

# 页面本体：每次都回源校验，改了前端立刻生效，不会让旧版本卡在缓存里
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 第三方库：体积大、极少变动。运行时跟版本走，改版本要清缓存，所以给 30 天
/vendor/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

# 姿态模型是固定权重，内容永不变化：直接缓存一年，下过一次就基本不再下
/models/*
  Cache-Control: public, max-age=31536000, immutable

# 示例媒体
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Accept-Ranges: bytes

# MediaPipe 的 wasm 必须以 application/wasm 返回，否则流式编译失败
/vendor/mediapipe/vision_wasm_internal.wasm
  Content-Type: application/wasm

/vendor/mediapipe/vision_wasm_nosimd_internal.wasm
  Content-Type: application/wasm

# 姿态模型是二进制权重，别让浏览器当文本猜类型
/models/pose_landmarker_full.task
  Content-Type: application/octet-stream
